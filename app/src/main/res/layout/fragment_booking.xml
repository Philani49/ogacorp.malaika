<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/malaika_beige_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Book Appointment"
            android:textColor="@color/malaika_brown"
            android:fontFamily="serif"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Service"
            android:textColor="@color/malaika_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbNails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:layout_marginTop="8dp"
                android:padding="16dp"
                android:text="Nails"
                android:textColor="@color/malaika_brown"
                android:buttonTint="@color/malaika_taupe"/>

            <RadioButton
                android:id="@+id/rbEyelashes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:layout_marginTop="8dp"
                android:padding="16dp"
                android:text="Eyelashes"
                android:textColor="@color/malaika_brown"
                android:buttonTint="@color/malaika_taupe"/>

            <RadioButton
                android:id="@+id/rbMassage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:layout_marginTop="8dp"
                android:padding="16dp"
                android:text="Massage"
                android:textColor="@color/malaika_brown"
                android:buttonTint="@color/malaika_taupe"/>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Date"
            android:textColor="@color/malaika_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickDate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Tap to choose date"
            android:textColor="@color/malaika_text_grey"
            app:strokeColor="@color/divider"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Time"
            android:textColor="@color/malaika_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTimeSlot"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Staff"
            android:textColor="@color/malaika_brown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spStaff"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmBooking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:text="Confirm Booking"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/malaika_taupe"
            app:cornerRadius="28dp" />
    </LinearLayout>
</ScrollView>